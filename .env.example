# Copiá este archivo a ".env" y completá los valores.
# ".env" nunca se sube a ningun lado (ya esta en .gitignore) porque tiene datos sensibles.

PORT=3000

# El dominio real donde publiques tu sitio (para que el form pueda llamar a este backend).
# Mientras probás podés dejarlo en *, pero antes de publicar poné tu dominio real.
ALLOWED_ORIGIN=*

# Clave para ver los leads guardados en GET /api/leads (inventala vos, cualquier texto largo y random)
ADMIN_TOKEN=cambia-esto-por-una-clave-larga-y-random

# --- Email (se usa tu Gmail para mandar notificaciones) ---
# 1. Activa la verificacion en 2 pasos en tu cuenta de Gmail (myaccount.google.com/security)
# 2. Genera una "contraseña de aplicacion" en https://myaccount.google.com/apppasswords
#    (elegi "Otra" como app, poné "Trayecto Web" y copia el codigo de 16 letras)
GMAIL_USER=hola.trayecto@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# A que email querés que te lleguen los avisos de nuevos contactos (puede ser el mismo GMAIL_USER)
NOTIFY_EMAIL=hola.trayecto@gmail.com

# --- Google Calendar (para crear el Google Meet automaticamente) ---
# Son 3 datos que se sacan una sola vez siguiendo el README -> "Configurar Google Calendar".
# Si los dejás vacíos, el backend funciona igual (guarda el lead y manda el email),
# simplemente no crea el evento de Meet solo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
